{
  "schema": 1,
  "id": "mobile",
  "name": "Mobile",
  "description": "Synthetic pack for tests: a mobile app stack in Kotlin and Java.",
  "detect": [
    {
      "path": "**/build.gradle.kts",
      "contains": "mobile.application"
    },
    {
      "path": "**/build.gradle.kts",
      "contains": "mobile.library"
    },
    {
      "path": "**/src/main/Manifest.xml"
    }
  ],
  "languages": [
    {
      "id": "kotlin",
      "extensions": [
        ".kt",
        ".kts"
      ],
      "lexer": "lexer/kotlin.json"
    },
    {
      "id": "java",
      "extensions": [
        ".java"
      ],
      "lexer": "lexer/java.json"
    }
  ],
  "profiles": [
    "app",
    "library"
  ],
  "profileDetect": [
    {
      "profile": "library",
      "path": "**/build.gradle.kts",
      "contains": "maven-publish"
    },
    {
      "profile": "library",
      "path": "**/build.gradle.kts",
      "contains": "mobile.library"
    }
  ],
  "defaultProfile": "app",
  "dimensions": [
    {
      "id": "ui-toolkit",
      "values": [
        "views",
        "compose",
        "both"
      ],
      "detect": [
        {
          "value": "compose",
          "path": "**/build.gradle.kts",
          "contains": "androidx.compose"
        },
        {
          "value": "compose",
          "path": "**/build.gradle.kts",
          "contains": "compose = true"
        },
        {
          "value": "views",
          "path": "**/build.gradle.kts",
          "contains": "viewBinding = true"
        },
        {
          "value": "views",
          "path": "**/build.gradle.kts",
          "contains": "dataBinding = true"
        }
      ],
      "default": "both",
      "combined": "both"
    }
  ],
  "rules": "rules.json",
  "templates": [
    "templates/summary.md"
  ],
  "noise": [
    "**/build/**",
    "gradle/verification-metadata.xml"
  ],
  "testFiles": [
    "**/test/**"
  ],
  "generatedMarkers": [
    "Code generated by"
  ]
}
