{
  "schema": 1,
  "pack": "web",
  "rules": [
    {
      "id": "no-eval",
      "title": "eval call",
      "severity": "BLOCKER",
      "description": "Synthetic rule for tests.",
      "why": "Evaluated strings run with the page's privileges, so injected text runs as code.",
      "fix": "Parse the data instead of evaluating it.",
      "languages": [
        "script"
      ],
      "tags": [
        "security"
      ],
      "match": {
        "patterns": [
          {
            "tokens": [
              {
                "kind": "identifier",
                "text": "eval"
              },
              {
                "kind": "punct",
                "text": "("
              }
            ]
          }
        ]
      }
    }
  ]
}
