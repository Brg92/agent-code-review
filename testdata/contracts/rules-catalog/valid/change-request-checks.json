{
  "schema": 1,
  "pack": "android",
  "rules": [
    {
      "id": "missing-tests",
      "title": "Missing unit tests",
      "severity": "MAJOR",
      "description": "Unit tests for every ViewModel, repository or helper added or changed.",
      "why": "Regressions in the logic of the component cannot be detected before release.",
      "fix": "Add a unit test for the component.",
      "languages": [
        "kotlin",
        "java"
      ],
      "tags": [
        "tests"
      ],
      "match": {
        "scope": "change-request",
        "detector": "missing-test",
        "sources": [
          "**/src/main/**/*.kt",
          "**/src/main/**/*.java"
        ],
        "nameSuffixes": [
          "ViewModel",
          "Repository"
        ],
        "moduleSeparator": "src/main/",
        "testRoots": [
          "src/test",
          "src/androidTest"
        ],
        "testName": "{name}Test",
        "testExtensions": [
          ".kt",
          ".java"
        ]
      }
    },
    {
      "id": "flavor-asymmetry",
      "title": "A change in one flavor only",
      "severity": "MAJOR",
      "needsJudgement": true,
      "description": "A change under one flavor source set without its counterpart in the others.",
      "languages": [],
      "tags": [
        "variants"
      ],
      "match": {
        "scope": "change-request",
        "detector": "counterpart",
        "groupsFrom": "config.variants",
        "groupPattern": "src/{group}/"
      }
    },
    {
      "id": "platform-asymmetry",
      "title": "A change in one platform only",
      "severity": "MAJOR",
      "needsJudgement": true,
      "description": "A change in one platform source set without its counterpart in the others.",
      "languages": [
        "kotlin"
      ],
      "tags": [
        "multiplatform"
      ],
      "match": {
        "scope": "change-request",
        "detector": "counterpart",
        "groups": [
          "androidMain",
          "iosMain"
        ],
        "groupPattern": "src/{group}/",
        "stripSuffixes": [
          ".android",
          ".ios"
        ]
      }
    }
  ]
}
