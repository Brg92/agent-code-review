{
  "schema": 1,
  "pack": "android",
  "defaults": {
    "files": {
      "exclude": [
        "**/*.kts"
      ],
      "tests": "skip"
    },
    "ignoreLines": [
      {
        "tokens": [
          {
            "kind": "word",
            "oneOf": [
              "import",
              "package"
            ]
          }
        ]
      }
    ]
  },
  "rules": [
    {
      "id": "strict-version-pin",
      "title": "Strict dependency version",
      "severity": "BLOCKER",
      "description": "A strict version (`!!`, `strictly`) overrides every other request for the module in the whole build. Declare the plain version.",
      "why": "A strict version forces every module of the build onto this version, or makes resolution fail when another module asks for a different one.",
      "fix": "Declare the plain version, without `!!` or `strictly`.",
      "languages": [],
      "tags": [
        "dependencies"
      ],
      "match": {
        "files": {
          "include": [
            "**/*.gradle",
            "**/*.gradle.kts",
            "**/*.versions.toml",
            "**/gradle.properties"
          ],
          "tests": "include"
        },
        "patterns": [
          {
            "tokens": [
              {
                "kind": [
                  "string",
                  "raw-string"
                ],
                "regexp": "!![\"']+$"
              }
            ]
          },
          {
            "tokens": [
              {
                "kind": "word",
                "text": "strictly"
              },
              {
                "kind": "punct",
                "oneOf": [
                  "(",
                  "="
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": "new-live-data",
      "title": "LiveData in new code",
      "severity": "MAJOR",
      "description": "Use `StateFlow` or `SharedFlow` instead of `LiveData`, `MutableLiveData` or `MediatorLiveData`.",
      "why": "New code adds `LiveData` next to Flow, which splits the state model and ties it to the Android lifecycle.",
      "fix": "Expose a `StateFlow` or `SharedFlow`, or justify the `LiveData` with a comment on its declaration.",
      "languages": [
        "kotlin",
        "java"
      ],
      "tags": [
        "state"
      ],
      "match": {
        "patterns": [
          {
            "tokens": [
              {
                "kind": "identifier",
                "regexp": "^(Mutable|Mediator)?LiveData$"
              },
              {
                "kind": "punct",
                "text": "<"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "local-broadcast-manager",
      "title": "In-process broadcasts",
      "severity": "MAJOR",
      "description": "Use a Flow or a Channel instead of `LocalBroadcastManager` or a `BroadcastReceiver` for in-process communication.",
      "why": "Senders and receivers of an in-process broadcast are untyped and drift apart without a compile error, and `LocalBroadcastManager` is deprecated.",
      "fix": "Communicate through a `Flow` or a `Channel` owned by a shared component.",
      "languages": [
        "kotlin",
        "java"
      ],
      "tags": [
        "state"
      ],
      "match": {
        "patterns": [
          {
            "tokens": [
              {
                "kind": "identifier",
                "text": "LocalBroadcastManager"
              }
            ]
          },
          {
            "languages": [
              "kotlin"
            ],
            "tokens": [
              {
                "kind": "punct",
                "text": ":"
              },
              {
                "kind": "identifier",
                "text": "BroadcastReceiver"
              },
              {
                "kind": "punct",
                "text": "("
              }
            ]
          },
          {
            "languages": [
              "java"
            ],
            "tokens": [
              {
                "kind": "word",
                "text": "extends"
              },
              {
                "kind": "identifier",
                "text": "BroadcastReceiver"
              }
            ]
          },
          {
            "tokens": [
              {
                "kind": "identifier",
                "text": "registerReceiver"
              },
              {
                "kind": "punct",
                "text": "("
              }
            ]
          }
        ]
      }
    },
    {
      "id": "find-view-by-id",
      "title": "findViewById",
      "severity": "MAJOR",
      "description": "Use view binding instead of `findViewById`.",
      "why": "A wrong id or view type is not caught at compile time and crashes at runtime, and every call searches the hierarchy again.",
      "fix": "Use the view binding of the layout.",
      "languages": [
        "kotlin",
        "java"
      ],
      "tags": [
        "views"
      ],
      "match": {
        "patterns": [
          {
            "tokens": [
              {
                "kind": "identifier",
                "text": "findViewById"
              },
              {
                "kind": "punct",
                "oneOf": [
                  "<",
                  "("
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": "global-scope",
      "title": "Coroutine launched in GlobalScope",
      "severity": "BLOCKER",
      "description": "Work in `GlobalScope` escapes every lifecycle and cannot be cancelled.",
      "why": "The work outlives the component that started it and can never be cancelled, so it leaks and keeps running after the user leaves.",
      "fix": "Launch it in a scope tied to the component, such as `viewModelScope` or `lifecycleScope`, or take a `CoroutineScope` from the caller.",
      "languages": [
        "kotlin",
        "java"
      ],
      "tags": [
        "coroutines"
      ],
      "match": {
        "patterns": [
          {
            "tokens": [
              {
                "kind": "identifier",
                "text": "GlobalScope"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "launch-when-started",
      "title": "launchWhen* coroutine builders",
      "severity": "BLOCKER",
      "description": "`launchWhenCreated`, `launchWhenStarted` and `launchWhenResumed` suspend work instead of cancelling it; use `repeatOnLifecycle`.",
      "why": "The collection stays alive while the view is stopped, so upstream work goes on and the observer stays attached to a destroyed view.",
      "fix": "Collect inside `repeatOnLifecycle(Lifecycle.State.STARTED)` in `viewLifecycleOwner.lifecycleScope`.",
      "languages": [
        "kotlin",
        "java"
      ],
      "tags": [
        "coroutines"
      ],
      "match": {
        "patterns": [
          {
            "tokens": [
              {
                "kind": "identifier",
                "regexp": "^launchWhen(Created|Started|Resumed)$"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "async-task",
      "title": "AsyncTask",
      "severity": "MAJOR",
      "description": "`AsyncTask` is deprecated and leaks the enclosing instance.",
      "why": "The task keeps the enclosing instance alive until it finishes, which leaks the Activity or Fragment, and the API is deprecated.",
      "fix": "Replace it with a coroutine in a lifecycle-aware scope, or with an executor.",
      "languages": [
        "kotlin",
        "java"
      ],
      "tags": [
        "concurrency"
      ],
      "match": {
        "patterns": [
          {
            "tokens": [
              {
                "kind": "identifier",
                "text": "AsyncTask"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "lateinit-binding",
      "title": "lateinit view binding",
      "severity": "MAJOR",
      "description": "A `lateinit var` binding outlives the view; use a nullable backing property cleared in `onDestroyView`.",
      "why": "The binding stays a stale non-null reference after the view is destroyed, which leaks the view tree or crashes on access.",
      "fix": "Use a nullable backing field that is cleared in `onDestroyView`.",
      "languages": [
        "kotlin",
        "java"
      ],
      "tags": [
        "views"
      ],
      "match": {
        "patterns": [
          {
            "tokens": [
              {
                "kind": "word",
                "text": "lateinit"
              },
              {
                "kind": "word",
                "text": "var"
              },
              {
                "kind": "identifier",
                "regexp": "[Bb]inding$"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "full-list-refresh",
      "title": "Full list refresh",
      "severity": "MAJOR",
      "description": "Use `DiffUtil` or Paging instead of `notifyDataSetChanged()`.",
      "why": "`notifyDataSetChanged` rebinds every item on each change, which wastes work and drops item animations.",
      "fix": "Compute the changes with `DiffUtil` or `ListAdapter`, or use Paging.",
      "languages": [
        "kotlin",
        "java"
      ],
      "tags": [
        "performance"
      ],
      "match": {
        "patterns": [
          {
            "tokens": [
              {
                "kind": "identifier",
                "text": "notifyDataSetChanged"
              },
              {
                "kind": "punct",
                "text": "("
              }
            ]
          }
        ]
      }
    },
    {
      "id": "run-blocking-prod",
      "title": "runBlocking in production code",
      "severity": "BLOCKER",
      "description": "`runBlocking` blocks the calling thread; on the main thread it is an ANR.",
      "why": "The calling thread stops until the block completes; on the main thread this freezes the UI and can cause an ANR.",
      "fix": "Make the caller a suspend function, or launch the work in a lifecycle-aware scope.",
      "languages": [
        "kotlin",
        "java"
      ],
      "tags": [
        "coroutines"
      ],
      "match": {
        "patterns": [
          {
            "tokens": [
              {
                "kind": "identifier",
                "text": "runBlocking"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "generic-exception",
      "title": "Catching Exception or Throwable",
      "severity": "MAJOR",
      "description": "Catch specific exceptions, not `Exception` or `Throwable`, unless the boundary handles everything.",
      "why": "Catching `Exception` or `Throwable` also swallows unexpected failures, including `CancellationException`, which breaks coroutine cancellation.",
      "fix": "Catch the specific exceptions the call can throw, and rethrow `CancellationException`.",
      "languages": [
        "kotlin",
        "java"
      ],
      "tags": [
        "errors"
      ],
      "match": {
        "patterns": [
          {
            "languages": [
              "kotlin"
            ],
            "tokens": [
              {
                "kind": "word",
                "text": "catch"
              },
              {
                "kind": "punct",
                "text": "("
              },
              {
                "kind": "identifier"
              },
              {
                "kind": "punct",
                "text": ":"
              },
              {
                "repeat": [
                  {
                    "kind": "word"
                  },
                  {
                    "kind": "punct",
                    "text": "."
                  }
                ]
              },
              {
                "kind": "identifier",
                "oneOf": [
                  "Exception",
                  "Throwable"
                ]
              },
              {
                "kind": "punct",
                "text": ")"
              }
            ]
          },
          {
            "languages": [
              "java"
            ],
            "tokens": [
              {
                "kind": "word",
                "text": "catch"
              },
              {
                "kind": "punct",
                "text": "("
              },
              {
                "repeat": [
                  {
                    "kind": "word",
                    "text": "final"
                  }
                ],
                "max": 1
              },
              {
                "repeat": [
                  {
                    "repeat": [
                      {
                        "kind": "word"
                      },
                      {
                        "kind": "punct",
                        "text": "."
                      }
                    ]
                  },
                  {
                    "kind": "identifier"
                  },
                  {
                    "kind": "punct",
                    "text": "|"
                  }
                ]
              },
              {
                "repeat": [
                  {
                    "kind": "word"
                  },
                  {
                    "kind": "punct",
                    "text": "."
                  }
                ]
              },
              {
                "kind": "identifier",
                "oneOf": [
                  "Exception",
                  "Throwable"
                ]
              },
              {
                "repeat": [
                  {
                    "kind": "punct",
                    "text": "|"
                  },
                  {
                    "repeat": [
                      {
                        "kind": "word"
                      },
                      {
                        "kind": "punct",
                        "text": "."
                      }
                    ]
                  },
                  {
                    "kind": "identifier"
                  }
                ]
              },
              {
                "kind": "identifier"
              },
              {
                "kind": "punct",
                "text": ")"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "hardcoded-dispatcher",
      "title": "Hard-coded coroutine dispatcher",
      "severity": "MAJOR",
      "description": "Inject dispatchers so the code stays testable.",
      "why": "Tests cannot replace the dispatcher, so the code runs on real threads under test and becomes slow or flaky.",
      "fix": "Inject the dispatcher through the constructor and use it instead of naming `Dispatchers` in the code.",
      "languages": [
        "kotlin",
        "java"
      ],
      "tags": [
        "coroutines"
      ],
      "match": {
        "patterns": [
          {
            "tokens": [
              {
                "kind": "identifier",
                "text": "Dispatchers"
              },
              {
                "kind": "punct",
                "text": "."
              },
              {
                "kind": "identifier",
                "oneOf": [
                  "IO",
                  "Default",
                  "Main",
                  "Unconfined"
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": "no-double-bang",
      "title": "Not-null assertion",
      "severity": "MAJOR",
      "needsJudgement": true,
      "description": "BLOCKER when the value comes from outside the process or the user, MAJOR otherwise. The ViewBinding accessor `get() = _binding!!` is not reported.",
      "why": "`!!` throws a NullPointerException as soon as the value is null, which crashes the app.",
      "fix": "Handle null with `?.`, `?:`, a smart cast or `requireNotNull` with a message.",
      "languages": [
        "kotlin"
      ],
      "tags": [
        "nullability"
      ],
      "match": {
        "patterns": [
          {
            "tokens": [
              {
                "kind": "punct",
                "text": "!!"
              }
            ]
          }
        ],
        "exclude": [
          {
            "tokens": [
              {
                "kind": "word",
                "text": "get"
              },
              {
                "kind": "punct",
                "text": "("
              },
              {
                "kind": "punct",
                "text": ")"
              },
              {
                "kind": "punct",
                "text": "="
              },
              {
                "kind": "identifier",
                "regexp": "^_\\w*[Bb]inding$"
              },
              {
                "kind": "punct",
                "text": "!!"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "empty-catch",
      "title": "Empty catch block",
      "severity": "BLOCKER",
      "description": "An error that vanishes is a bug that will be diagnosed twice.",
      "why": "The error disappears without a trace, so the failure surfaces later somewhere else and is hard to diagnose.",
      "fix": "Handle the error, rethrow it, or add a comment that explains why it is safe to ignore.",
      "languages": [
        "kotlin",
        "java"
      ],
      "tags": [
        "errors"
      ],
      "match": {
        "patterns": [
          {
            "tokens": [
              {
                "kind": "word",
                "text": "catch"
              },
              {
                "kind": "punct",
                "text": "("
              },
              {
                "gap": {
                  "balanced": true
                }
              },
              {
                "kind": "punct",
                "text": ")"
              },
              {
                "kind": "punct",
                "text": "{"
              },
              {
                "kind": "punct",
                "text": "}"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "line-too-long",
      "title": "Line too long",
      "severity": "MINOR",
      "description": "Lines within the configured length.",
      "why": "Lines over 100 characters force horizontal scrolling and make the code and its diffs harder to read.",
      "fix": "Wrap the line within 100 characters.",
      "languages": [
        "kotlin",
        "java"
      ],
      "tags": [
        "style"
      ],
      "match": {
        "detector": "line-length",
        "max": 100,
        "lines": "added"
      }
    },
    {
      "id": "field-injection",
      "title": "Field injection",
      "severity": "MAJOR",
      "description": "Constructor injection over field injection. Hilt entry points, which need field injection, are not reported.",
      "why": "The dependency is hidden from the constructor, so the class can exist half-initialised and is hard to test.",
      "fix": "Inject the dependency through the constructor.",
      "languages": [
        "kotlin",
        "java"
      ],
      "tags": [
        "di"
      ],
      "match": {
        "files": {
          "exclude": [
            "**/*.kts"
          ],
          "notContains": [
            {
              "tokens": [
                {
                  "kind": "punct",
                  "text": "@"
                },
                {
                  "kind": "identifier",
                  "oneOf": [
                    "AndroidEntryPoint",
                    "HiltAndroidApp"
                  ]
                }
              ]
            }
          ]
        },
        "patterns": [
          {
            "languages": [
              "kotlin"
            ],
            "tokens": [
              {
                "kind": "punct",
                "text": "@"
              },
              {
                "kind": "identifier",
                "text": "Inject"
              },
              {
                "gap": {
                  "max": 16,
                  "balanced": true,
                  "stopAt": [
                    {
                      "kind": "punct",
                      "oneOf": [
                        "{",
                        "}",
                        ";",
                        "="
                      ]
                    },
                    {
                      "kind": "word",
                      "oneOf": [
                        "fun",
                        "val",
                        "class",
                        "constructor"
                      ]
                    }
                  ]
                }
              },
              {
                "kind": "word",
                "text": "var",
                "at": true
              }
            ]
          },
          {
            "languages": [
              "java"
            ],
            "tokens": [
              {
                "kind": "punct",
                "text": "@"
              },
              {
                "kind": "identifier",
                "text": "Inject"
              },
              {
                "repeat": [
                  {
                    "kind": "punct",
                    "text": "@"
                  },
                  {
                    "kind": "word"
                  },
                  {
                    "repeat": [
                      {
                        "kind": "punct",
                        "text": "."
                      },
                      {
                        "kind": "word"
                      }
                    ]
                  },
                  {
                    "repeat": [
                      {
                        "kind": "punct",
                        "text": "("
                      },
                      {
                        "gap": {
                          "balanced": true
                        }
                      },
                      {
                        "kind": "punct",
                        "text": ")"
                      }
                    ],
                    "max": 1
                  }
                ]
              },
              {
                "gap": {
                  "max": 16,
                  "stopAt": [
                    {
                      "kind": "punct",
                      "oneOf": [
                        "(",
                        "{",
                        "}",
                        ";",
                        "=",
                        "@"
                      ]
                    }
                  ]
                }
              },
              {
                "kind": "identifier",
                "at": true
              },
              {
                "kind": "punct",
                "oneOf": [
                  ";",
                  "="
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": "missing-kdoc",
      "title": "Declaration without KDoc",
      "severity": "MINOR",
      "needsJudgement": true,
      "description": "MAJOR on a public symbol of a library or of a module other modules call, MINOR otherwise.",
      "why": "Callers have to read the source to learn what the declaration does, what it expects and what it throws.",
      "fix": "Add KDoc that states what the declaration does, its preconditions and what it throws.",
      "languages": [
        "kotlin"
      ],
      "tags": [
        "docs"
      ],
      "match": {
        "detector": "missing-doc",
        "lines": "added",
        "declarations": [
          "fun",
          "val",
          "var",
          "class",
          "interface",
          "object"
        ],
        "modifiers": [
          "public",
          "open",
          "abstract",
          "final",
          "data",
          "sealed",
          "inline",
          "value",
          "suspend",
          "operator",
          "infix",
          "tailrec",
          "const",
          "lateinit",
          "enum"
        ],
        "skipModifiers": [
          "private",
          "internal",
          "protected",
          "override"
        ],
        "types": [
          "class",
          "interface",
          "object"
        ],
        "notAfter": [
          "::"
        ],
        "annotation": "@",
        "skipAnnotations": [
          "Inject"
        ],
        "header": {
          "open": "(",
          "close": ")"
        },
        "body": {
          "open": "{",
          "close": "}"
        }
      }
    },
    {
      "id": "missing-tests",
      "title": "Missing unit tests",
      "severity": "MAJOR",
      "description": "Unit tests for every ViewModel, repository, mapper or helper added or modified. Checked on the whole change request.",
      "languages": [
        "kotlin",
        "java"
      ],
      "tags": [
        "tests"
      ]
    }
  ]
}
