{
  "schema": 1,
  "id": "kotlin-multiplatform",
  "name": "Kotlin Multiplatform",
  "description": "Kotlin Multiplatform modules with shared, Android and iOS source sets.",
  "detect": [
    {
      "path": "**/src/commonMain"
    },
    {
      "path": "**/build.gradle.kts",
      "contains": "kotlin(\"multiplatform\")"
    },
    {
      "path": "**/build.gradle.kts",
      "contains": "org.jetbrains.kotlin.multiplatform"
    }
  ],
  "languages": [
    {
      "id": "kotlin",
      "extensions": [
        ".kt",
        ".kts"
      ],
      "lexer": "lexer/kotlin.json",
      "symbols": {
        "packageKeyword": "package",
        "declarations": [
          {
            "word": "fun",
            "kind": "method"
          },
          {
            "word": "val",
            "kind": "property"
          },
          {
            "word": "var",
            "kind": "property"
          },
          {
            "word": "class",
            "kind": "type"
          },
          {
            "word": "interface",
            "kind": "type"
          },
          {
            "word": "object",
            "kind": "type"
          },
          {
            "word": "typealias",
            "kind": "type"
          }
        ],
        "hidingModifiers": [
          "private",
          "internal"
        ],
        "publicModifiers": [
          "public",
          "protected"
        ],
        "publicByDefault": true,
        "annotation": "@",
        "qualifiers": [
          ".",
          "?."
        ],
        "body": {
          "open": "{",
          "close": "}"
        },
        "parameters": {
          "open": "(",
          "close": ")"
        },
        "typeParameters": {
          "open": "<",
          "close": ">"
        },
        "parameterSeparator": ",",
        "parameterType": ":",
        "parameterDefault": "="
      }
    }
  ],
  "profiles": [
    "library",
    "app"
  ],
  "rules": "rules.json",
  "templates": [],
  "noise": [
    "kotlin-js-store/yarn.lock"
  ],
  "testFiles": [
    "**/src/commonTest/**",
    "**/src/androidUnitTest/**",
    "**/src/ios*Test/**"
  ],
  "generatedMarkers": [
    "Code generated by"
  ],
  "defaultProfile": "library",
  "priority": 10,
  "fileDimensions": [
    {
      "id": "platform",
      "values": [
        "common",
        "android",
        "ios"
      ],
      "map": [
        {
          "path": "**/src/commonMain/**",
          "value": "common"
        },
        {
          "path": "**/src/commonTest/**",
          "value": "common"
        },
        {
          "path": "**/src/androidMain/**",
          "value": "android"
        },
        {
          "path": "**/src/androidUnitTest/**",
          "value": "android"
        },
        {
          "path": "**/src/ios*Main/**",
          "value": "ios"
        },
        {
          "path": "**/src/ios*Test/**",
          "value": "ios"
        }
      ],
      "default": "common"
    }
  ]
}
