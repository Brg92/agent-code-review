{
  "schema": 1,
  "id": "android",
  "name": "Android",
  "description": "Android apps and libraries in Kotlin and Java, with Gradle.",
  "detect": [
    {
      "path": "**/build.gradle.kts",
      "contains": "com.android."
    },
    {
      "path": "**/build.gradle",
      "contains": "com.android."
    },
    {
      "path": "**/src/main/AndroidManifest.xml"
    }
  ],
  "languages": [
    {
      "id": "kotlin",
      "extensions": [
        ".kt",
        ".kts"
      ],
      "lexer": "lexer/kotlin.json"
    },
    {
      "id": "java",
      "extensions": [
        ".java"
      ],
      "lexer": "lexer/java.json"
    }
  ],
  "profiles": [
    "app",
    "library"
  ],
  "profileDetect": [
    {
      "profile": "library",
      "path": "**/build.gradle.kts",
      "contains": "maven-publish"
    },
    {
      "profile": "library",
      "path": "**/build.gradle",
      "contains": "maven-publish"
    }
  ],
  "defaultProfile": [
    "app"
  ],
  "rules": "rules.json",
  "checklists": [
    {
      "profile": "app",
      "path": "checklists/app.md"
    },
    {
      "profile": "library",
      "path": "checklists/library.md"
    }
  ],
  "templates": [
    "templates/summary.md",
    "templates/comment.md"
  ],
  "noise": [
    "gradle/verification-metadata.xml",
    "**/build/**"
  ],
  "generatedMarkers": [
    "Code generated by",
    "DO NOT EDIT",
    "@Generated"
  ]
}
