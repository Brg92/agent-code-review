{
  "schema": 1,
  "id": "kotlin-multiplatform",
  "name": "Kotlin Multiplatform",
  "description": "Kotlin Multiplatform modules with shared, Android and iOS source sets.",
  "detect": [
    {
      "path": "**/src/commonMain"
    },
    {
      "path": "**/build.gradle.kts",
      "contains": "kotlin(\"multiplatform\")"
    }
  ],
  "languages": [
    {
      "id": "kotlin",
      "extensions": [
        ".kt",
        ".kts"
      ]
    }
  ],
  "profiles": [
    "kmp"
  ],
  "rules": "rules.json",
  "lexer": "lexer.json",
  "checklists": [
    {
      "profile": "kmp",
      "path": "checklists/kmp.md"
    }
  ],
  "templates": [],
  "noise": [
    "kotlin-js-store/yarn.lock"
  ],
  "generatedMarkers": [
    "Code generated by"
  ]
}
