{
  "schema": 1,
  "id": "kotlin-multiplatform",
  "name": "Kotlin Multiplatform",
  "description": "Kotlin Multiplatform modules with shared, Android and iOS source sets.",
  "detect": [
    {
      "path": "**/src/commonMain"
    },
    {
      "path": "**/build.gradle.kts",
      "contains": "kotlin(\"multiplatform\")"
    },
    {
      "path": "**/build.gradle.kts",
      "contains": "org.jetbrains.kotlin.multiplatform"
    }
  ],
  "languages": [
    {
      "id": "kotlin",
      "extensions": [
        ".kt",
        ".kts"
      ],
      "lexer": "lexer/kotlin.json"
    }
  ],
  "profiles": [
    "library",
    "app"
  ],
  "rules": "rules.json",
  "templates": [],
  "noise": [
    "kotlin-js-store/yarn.lock"
  ],
  "testFiles": [
    "**/src/commonTest/**",
    "**/src/androidUnitTest/**",
    "**/src/ios*Test/**"
  ],
  "generatedMarkers": [
    "Code generated by"
  ],
  "defaultProfile": "library",
  "priority": 10,
  "fileDimensions": [
    {
      "id": "platform",
      "values": [
        "common",
        "android",
        "ios"
      ],
      "map": [
        {
          "path": "**/src/commonMain/**",
          "value": "common"
        },
        {
          "path": "**/src/commonTest/**",
          "value": "common"
        },
        {
          "path": "**/src/androidMain/**",
          "value": "android"
        },
        {
          "path": "**/src/androidUnitTest/**",
          "value": "android"
        },
        {
          "path": "**/src/ios*Main/**",
          "value": "ios"
        },
        {
          "path": "**/src/ios*Test/**",
          "value": "ios"
        }
      ],
      "default": "common"
    }
  ]
}
