{
  "schema": 1,
  "id": "android",
  "name": "Android",
  "description": "Android apps and libraries in Kotlin and Java, with Gradle.",
  "detect": [
    {
      "path": "**/build.gradle.kts",
      "contains": "com.android."
    },
    {
      "path": "**/build.gradle",
      "contains": "com.android."
    },
    {
      "path": "**/src/main/AndroidManifest.xml"
    }
  ],
  "languages": [
    {
      "id": "kotlin",
      "extensions": [
        ".kt",
        ".kts"
      ],
      "lexer": "lexer/kotlin.json",
      "symbols": {
        "packageKeyword": "package",
        "declarations": [
          {
            "word": "fun",
            "kind": "function"
          },
          {
            "word": "val",
            "kind": "property"
          },
          {
            "word": "var",
            "kind": "property"
          },
          {
            "word": "class",
            "kind": "type"
          },
          {
            "word": "interface",
            "kind": "type"
          },
          {
            "word": "object",
            "kind": "type"
          },
          {
            "word": "typealias",
            "kind": "type"
          }
        ],
        "hidingModifiers": [
          "private",
          "internal"
        ],
        "publicModifiers": [
          "public",
          "protected"
        ],
        "publicByDefault": true,
        "annotation": "@",
        "qualifiers": [
          ".",
          "?."
        ],
        "body": {
          "open": "{",
          "close": "}"
        },
        "parameters": {
          "open": "(",
          "close": ")"
        },
        "typeParameters": {
          "open": "<",
          "close": ">"
        },
        "parameterSeparator": ",",
        "parameterType": ":",
        "parameterDefault": "="
      }
    },
    {
      "id": "java",
      "extensions": [
        ".java"
      ],
      "lexer": "lexer/java.json",
      "symbols": {
        "packageKeyword": "package",
        "declarations": [
          {
            "word": "class",
            "kind": "type"
          },
          {
            "word": "interface",
            "kind": "type"
          },
          {
            "word": "enum",
            "kind": "type"
          },
          {
            "word": "record",
            "kind": "type"
          }
        ],
        "typedMembers": {
          "ends": [
            "=",
            ";",
            ","
          ]
        },
        "hidingModifiers": [
          "private"
        ],
        "publicModifiers": [
          "public",
          "protected"
        ],
        "publicByDefault": false,
        "publicMembersIn": [
          "interface"
        ],
        "annotation": "@",
        "qualifiers": [
          "."
        ],
        "body": {
          "open": "{",
          "close": "}"
        },
        "parameters": {
          "open": "(",
          "close": ")"
        },
        "typeParameters": {
          "open": "<",
          "close": ">"
        },
        "parameterSeparator": ","
      }
    }
  ],
  "profiles": [
    "app",
    "library"
  ],
  "profileDetect": [
    {
      "profile": "library",
      "path": "**/build.gradle.kts",
      "contains": "maven-publish"
    },
    {
      "profile": "library",
      "path": "**/build.gradle",
      "contains": "maven-publish"
    }
  ],
  "defaultProfile": "app",
  "rules": "rules.json",
  "templates": [
    "templates/summary.md",
    "templates/comment.md"
  ],
  "noise": [
    "gradle/verification-metadata.xml",
    "**/build/**"
  ],
  "testFiles": [
    "**/test/**",
    "**/androidTest/**"
  ],
  "generatedMarkers": [
    "Code generated by",
    "DO NOT EDIT",
    "@Generated"
  ],
  "dimensions": [
    {
      "id": "ui-toolkit",
      "values": [
        "views",
        "compose",
        "both"
      ],
      "detect": [
        {
          "value": "compose",
          "path": "**/build.gradle.kts",
          "contains": "androidx.compose"
        },
        {
          "value": "views",
          "path": "**/build.gradle.kts",
          "contains": "viewBinding = true"
        }
      ],
      "default": "both",
      "combined": "both"
    }
  ]
}
