{
  "schema": 1,
  "id": "android",
  "name": "Android",
  "description": "Android apps and libraries in Kotlin and Java, built with Gradle.",
  "detect": [
    {
      "path": "**/build.gradle.kts",
      "contains": "com.android."
    },
    {
      "path": "**/build.gradle",
      "contains": "com.android."
    },
    {
      "path": "**/src/main/AndroidManifest.xml"
    }
  ],
  "languages": [
    {
      "id": "kotlin",
      "extensions": [
        ".kt",
        ".kts"
      ],
      "lexer": "lexer/kotlin.json"
    },
    {
      "id": "java",
      "extensions": [
        ".java"
      ],
      "lexer": "lexer/java.json"
    },
    {
      "id": "groovy",
      "extensions": [
        ".gradle"
      ],
      "lexer": "lexer/groovy.json"
    },
    {
      "id": "toml",
      "extensions": [
        ".toml"
      ],
      "lexer": "lexer/toml.json"
    },
    {
      "id": "properties",
      "extensions": [
        ".properties"
      ],
      "lexer": "lexer/properties.json"
    }
  ],
  "profiles": [
    "app",
    "library"
  ],
  "profileDetect": [
    {
      "profile": "library",
      "path": "**/build.gradle.kts",
      "contains": "maven-publish"
    },
    {
      "profile": "library",
      "path": "**/build.gradle",
      "contains": "maven-publish"
    },
    {
      "profile": "library",
      "path": "**/build.gradle.kts",
      "contains": "publishing {"
    },
    {
      "profile": "library",
      "path": "**/build.gradle",
      "contains": "publishing {"
    }
  ],
  "defaultProfile": "app",
  "dimensions": [
    {
      "id": "ui-toolkit",
      "values": [
        "views",
        "compose",
        "both"
      ],
      "detect": [
        {
          "value": "compose",
          "path": "**/build.gradle.kts",
          "contains": "androidx.compose"
        },
        {
          "value": "compose",
          "path": "**/build.gradle",
          "contains": "androidx.compose"
        },
        {
          "value": "compose",
          "path": "gradle/libs.versions.toml",
          "contains": "androidx.compose"
        },
        {
          "value": "compose",
          "path": "**/build.gradle.kts",
          "contains": "org.jetbrains.compose"
        },
        {
          "value": "compose",
          "path": "**/build.gradle",
          "contains": "org.jetbrains.compose"
        },
        {
          "value": "compose",
          "path": "gradle/libs.versions.toml",
          "contains": "org.jetbrains.compose"
        },
        {
          "value": "compose",
          "path": "**/build.gradle.kts",
          "contains": "compose = true"
        },
        {
          "value": "compose",
          "path": "**/build.gradle",
          "contains": "compose = true"
        },
        {
          "value": "compose",
          "path": "**/build.gradle",
          "contains": "compose true"
        },
        {
          "value": "views",
          "path": "**/build.gradle.kts",
          "contains": "viewBinding = true"
        },
        {
          "value": "views",
          "path": "**/build.gradle.kts",
          "contains": "dataBinding = true"
        },
        {
          "value": "views",
          "path": "**/build.gradle",
          "contains": "viewBinding = true"
        },
        {
          "value": "views",
          "path": "**/build.gradle",
          "contains": "viewBinding true"
        },
        {
          "value": "views",
          "path": "**/build.gradle",
          "contains": "dataBinding = true"
        },
        {
          "value": "views",
          "path": "**/build.gradle",
          "contains": "dataBinding true"
        }
      ],
      "default": "both",
      "combined": "both"
    }
  ],
  "fileDimensions": [
    {
      "id": "platform",
      "values": [
        "android"
      ],
      "map": [],
      "default": "android"
    }
  ],
  "rules": "rules.json",
  "templates": [
    "templates/app/criteria.md",
    "templates/app/config.json",
    "templates/library/criteria.md",
    "templates/library/config.json"
  ],
  "noise": [
    "gradle/verification-metadata.xml",
    "**/build/**"
  ],
  "testFiles": [
    "**/src/test/**",
    "**/src/androidTest/**"
  ],
  "generatedMarkers": [
    "Code generated by",
    "DO NOT EDIT",
    "@Generated"
  ]
}
