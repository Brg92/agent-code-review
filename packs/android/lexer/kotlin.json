{
  "schema": 1,
  "language": "kotlin",
  "extensions": [
    ".kt",
    ".kts"
  ],
  "lineComment": "//",
  "blockComment": {
    "open": "/*",
    "close": "*/",
    "nested": true
  },
  "docComment": "/**",
  "strings": [
    {
      "delimiter": "\"\"\"",
      "raw": true,
      "multiline": true,
      "templates": true,
      "greedyClose": true
    },
    {
      "delimiter": "\"",
      "escape": "\\",
      "templates": true
    }
  ],
  "char": {
    "delimiter": "'",
    "escape": "\\"
  },
  "quotedIdentifier": "`",
  "templates": {
    "identifier": "$",
    "open": "${",
    "close": "}"
  },
  "keywords": [
    "as",
    "break",
    "class",
    "continue",
    "do",
    "else",
    "false",
    "for",
    "fun",
    "if",
    "in",
    "interface",
    "is",
    "null",
    "object",
    "package",
    "return",
    "super",
    "this",
    "throw",
    "true",
    "try",
    "typealias",
    "typeof",
    "val",
    "var",
    "when",
    "while"
  ],
  "softKeywords": [
    "by",
    "catch",
    "constructor",
    "context",
    "delegate",
    "dynamic",
    "field",
    "file",
    "finally",
    "get",
    "import",
    "init",
    "param",
    "property",
    "receiver",
    "set",
    "setparam",
    "value",
    "where",
    "abstract",
    "actual",
    "annotation",
    "companion",
    "const",
    "crossinline",
    "data",
    "enum",
    "expect",
    "external",
    "final",
    "infix",
    "inline",
    "inner",
    "internal",
    "lateinit",
    "noinline",
    "open",
    "operator",
    "out",
    "override",
    "private",
    "protected",
    "public",
    "reified",
    "sealed",
    "suspend",
    "tailrec",
    "vararg"
  ],
  "operators": [
    "===",
    "!==",
    "==",
    "!=",
    "<=",
    ">=",
    "&&",
    "||",
    "!!",
    "?:",
    "?.",
    "::",
    "..<",
    "..",
    "->",
    "++",
    "--",
    "+=",
    "-=",
    "*=",
    "/=",
    "%="
  ]
}
